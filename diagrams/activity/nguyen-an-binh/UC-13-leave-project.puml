@startuml

!pragma useVerticalIf on

skinparam defaultFontName "Times New Roman"
skinparam activityFontSize 14
skinparam activityDiamondFontSize 13
skinparam arrowFontSize 12
skinparam swimlaneTitleFontSize 17
skinparam swimlaneWidth 200
skinparam wrapWidth 180
skinparam conditionStyle diamond
skinparam ConditionEndStyle diamond
skinparam shadowing false

|Project Member|
start
:Request to leave the project;

|System|
:Check ownership and
unfinished work constraints;

if (Actor is current\nProject Owner?) then ([current owner])
    :Reject the leave request and require
    project ownership transfer;
    stop
else ([not current owner])
endif

if (Member owns unfinished\nSprint Tasks?) then ([owns tasks])
    :Warn that unfinished work
    will become unclaimed;
else ([no unfinished tasks])
endif

:Explain the effects of leaving
and request confirmation;

|Project Member|
if (Member confirms\nleaving?) then ([confirmed])
    :Confirm leaving the project;

    |System|
    :Remove active membership and
    project-scoped permissions;
    stop
else ([cancelled])
    |Project Member|
    :Cancel the leave request;
    stop
endif

@enduml
