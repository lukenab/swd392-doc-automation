@startuml UC-SYSTEM-AUDIT-LOG-REVIEW
' UC-33 - Review System Audit Log | semantic key: UC-SYSTEM-AUDIT-LOG-REVIEW
' Source: data/use_cases/system-administration/UC-SYSTEM-AUDIT-LOG-REVIEW.yml
' Business Rules: BR-AUDIT-IMMUTABLE, BR-SYSADMIN-NO-PROJECT-AUTO-ACCESS, BR-AUDIT-EVENT-COMPLETENESS, BR-AUDIT-VIEW-SYSADMIN-ONLY
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' One Activity Final shared by all paths (team decision 2026-10-06; UML allows one or several). It
' is reached after matching events are displayed and reviewed (postcondition met), after no matching
' events are reported (AF-01) or after EX-01 (audit store unavailable, no events displayed; no
' System response described, so its guard goes straight to the final).
!include ../../_shared/activity-style.puml
|ADM| $lane_title("System Administrator")
|SYS| $lane_title("System")

|ADM|
start
' [NF1, TRIGGER, BR-AUDIT-VIEW-SYSADMIN-ONLY]
:Open system audit log;
|SYS|
if ($question_x("Audit store available?")) then ($guard_left("[available]"))
  ' [NF2]
  :Display recent audit events;
  |ADM|
  ' [NF3]
  :Filter events by time, actor,
  event type or target;
  |SYS|
  if ($question_x("Matching events found?")) then ($guard_left("[found]"))
    ' [NF4, BR-AUDIT-IMMUTABLE, BR-AUDIT-EVENT-COMPLETENESS]
    :Display matching events
    and recorded details;
    |ADM|
    ' [NF5, POST1]
    :Review results;
  else ($guard_right("[no match", "— AF-01]"))
    |SYS|
    ' [AF-01.1]
    :Report no matching events;
  endif
else ($guard_right("[temporarily unavailable", "— EX-01]"))
endif
|SYS|
stop
@enduml
