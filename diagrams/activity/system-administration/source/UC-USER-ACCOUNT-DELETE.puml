@startuml UC-USER-ACCOUNT-DELETE
' UC-32.4 - Delete User Account | semantic key: UC-USER-ACCOUNT-DELETE
' Source: data/use_cases/system-administration/UC-USER-ACCOUNT-DELETE.yml
' Business Rules: BR-SYSADMIN-USER-ACCOUNT, BR-OWNER-ACCOUNT-DELETION-GUARD, BR-LAST-ADMINISTRATOR-PROTECTION, BR-AUDIT-EVENT-COMPLETENESS
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' One Activity Final shared by all paths (team decision 2026-10-06; UML allows one or several). It
' is reached after the account is deleted with audit and attribution data preserved (postconditions
' met) or with the account unchanged (EX-01, EX-02, AF-01).
' EX-01 and EX-02 share one decision: both are protections on the requested target account
' (BR-OWNER-ACCOUNT-DELETION-GUARD, BR-LAST-ADMINISTRATOR-PROTECTION) and both reject the request.
' AF-01.1 is an explicit System step of the YAML, so it is kept as an action.
!include ../../_shared/activity-style.puml
|ADM| $lane_title("System Administrator")
|SYS| $lane_title("System")

|ADM|
start
' [NF1, TRIGGER, BR-SYSADMIN-USER-ACCOUNT]
:Select User account
and request deletion;
|SYS|
if ($question_x("Account protected?")) then ($guard_left("[not protected]"))
  ' [NF2]
  :Display ownership, membership
  and administrative impact;
  |ADM|
  if ($question_x("Confirm deletion?")) then ($guard_left("[confirm]"))
    ' [NF3]
    :Provide reason and
    confirm deletion;
    |SYS|
    ' [NF4, POST1, POST2, BR-AUDIT-EVENT-COMPLETENESS, OTHER]
    :Delete account and
    record audit event;
  else ($guard_right("[cancel", "— AF-01]"))
    |SYS|
    ' [AF-01.1]
    :Leave account unchanged;
  endif
else ($guard_right("[current owner — EX-01 or", "last administrator — EX-02]"))
  ' [EX-01, EX-02, BR-OWNER-ACCOUNT-DELETION-GUARD, BR-LAST-ADMINISTRATOR-PROTECTION, GUIDE-7.3]
  :Reject deletion;
endif
|SYS|
stop
@enduml
