@startuml UC-PASSWORD-CHANGE
' UC-05.3 - Change Password | semantic key: UC-PASSWORD-CHANGE
' Source: data/use_cases/account-authentication/UC-PASSWORD-CHANGE.yml
' Business Rules: BR-AUTH-ACTIVE-ACCOUNT, BR-PASSWORD-STRENGTH, BR-PROFILE-SELF-ACCESS
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' Final nodes: F1 = new password stored (postconditions met); F2 = password unchanged
' (AF-01, EX-01, EX-02 merge here).
!include ../../_shared/activity-style.puml
|USR| $lane_title("User")
|SYS| $lane_title("System")

|USR|
start
|SYS|
if ($question_x("Password managed locally?")) then ($guard_left("[locally managed]"))
  |USR|
  ' [NF1]
  :Enter the current
  password and a
  new password;
  |SYS|
  ' [NF2]
  :Verify the current password;
  if ($question("Current password correct?")) then ($guard_left("[correct]"))
    ' [NF3, BR-PASSWORD-STRENGTH]
    :Validate the new
    password against
    the password policy;
    if ($question("Policy satisfied?")) then ($guard_left("[satisfied]"))
      |USR|
      ' [NF4]
      :Confirm the
      password change;
      |SYS|
      ' [NF5, POST1]
      :Store the new
      password securely
      and confirm success;
      ' [POST2]
      :Record the password
      change as a
      security event;
      stop
    else ($guard_right("[not satisfied", "— EX-02]"))
      ' [EX-02, GUIDE-7.3]
      :Reject the
      new password;
    endif
  else ($guard_right("[incorrect", "— EX-01]"))
    ' [EX-01, GUIDE-7.3]
    :Reject the
    password change;
  endif
else ($guard_right("[provider only", "— AF-01]"))
  ' [AF-01.1]
  :Inform the User that
  the password must be
  changed through
  that provider;
endif
|SYS|
stop
@enduml
