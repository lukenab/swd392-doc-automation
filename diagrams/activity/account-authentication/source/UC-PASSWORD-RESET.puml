@startuml UC-PASSWORD-RESET
' UC-04 - Forgot Password | semantic key: UC-PASSWORD-RESET
' Source: data/use_cases/account-authentication/UC-PASSWORD-RESET.yml
' Business Rules: BR-PASSWORD-STRENGTH, BR-PASSWORD-RESET-TOKEN, BR-PASSWORD-RESET-PRIVACY
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' Final nodes: F1 = password updated and token invalidated (postconditions met);
' F2 = password unchanged (AF-02, no eligible account, EX-01, AF-01, EX-02 merge here).
!include ../../_shared/activity-style.puml
|USR| $lane_title("User")
|SYS| $lane_title("System")
|EML| $lane_title("Email Service")

|USR|
start
' [NF1]
:Open Forgot Password and
submit an email address;
|SYS|
' [NF2, BR-PASSWORD-RESET-PRIVACY]
:Display the same generic response
whether or not the account exists;
if ($question("Google-only account?")) then ($guard_left("[password account]"))
  if ($question("Eligible account?")) then ($guard_left("[eligible]"))
    ' [NF3, BR-PASSWORD-RESET-TOKEN]
    :Generate a single-use
    expiring reset token;
    |EML|
    ' [NF4]
    :Deliver the password-reset link
    to the eligible email address;
    |SYS|
    if ($question_x("Link delivered?")) then ($guard_left("[delivered]"))
      |USR|
      ' [NF5]
      :Open the link and
      submit a new password;
      |SYS|
      ' [NF6, BR-PASSWORD-STRENGTH]
      :Validate the token and
      the password strength;
      if ($question("Token valid?")) then ($guard_left("[valid]"))
        if ($question("Account status\nunchanged?")) then ($guard_left("[unchanged]"))
          ' [NF6, POST1, POST2]
          :Update the password and
          invalidate the used token;
          stop
        else ($guard_right("[status changed", "— EX-02]"))
          ' [EX-02]
          :Reject the password
          reset for the
          changed account;
        endif
      else ($guard_right("[invalid, expired", "or used — AF-01]"))
        ' [AF-01.1]
        :Reject the
        password change;
        ' [AF-01.2]
        :Allow the User to
        submit a new Forgot
        Password request;
      endif
    else ($guard_right("[not delivered", "— EX-01]"))
      ' [EX-01, BR-PASSWORD-RESET-PRIVACY]
      :Record the delivery
      failure without exposing
      whether the account exists;
    endif
  else ($guard_right("[no eligible", "account]"))
  endif
else ($guard_right("[Google only", "— AF-02]"))
  ' [AF-02.1]
  :Keep the generic response
  without creating a reset token;
  |USR|
  ' [AF-02.2]
  :Continue to authenticate
  through Google;
endif
|SYS|
stop
@enduml
