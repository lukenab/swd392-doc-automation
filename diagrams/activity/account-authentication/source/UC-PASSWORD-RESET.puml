@startuml UC-PASSWORD-RESET
' UC-04 - Forgot Password | semantic key: UC-PASSWORD-RESET
' Source: data/use_cases/account-authentication/UC-PASSWORD-RESET.yml
' Business Rules: BR-PASSWORD-STRENGTH, BR-PASSWORD-RESET-TOKEN, BR-PASSWORD-RESET-PRIVACY
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' AF-02.1 (generic response kept, no reset token created) is an outcome, not a separate action:
' the generic response is already displayed in NF2 and the AF-02 branch bypasses NF3.
' Final nodes: F1 = no reset token for a Google-only account, User continues through Google
' (AF-02); F2 = password updated and token invalidated (postconditions met); F3 = password
' unchanged (no eligible account, EX-01, AF-01, EX-02 merge here).
!include ../../_shared/activity-style.puml
|USR| $lane_title("User")
|SYS| $lane_title("System")
|EML| $lane_title("Email Service")

|USR|
start
' [NF1, TRIGGER]
:Open Forgot Password and
submit email address;
|SYS|
' [NF2, BR-PASSWORD-RESET-PRIVACY]
:Display generic response
for any email;
if ($question("Google-only account?")) then ($guard_right("[Google only", "— AF-02]"))
  |USR|
  ' [AF-02.2]
  :Continue authentication
  through Google;
  stop
else ($guard_right("[password account", "or no account]"))
endif
|SYS|
if ($question("Eligible account?")) then ($guard_left("[eligible]"))
  ' [NF3, BR-PASSWORD-RESET-TOKEN]
  :Generate single-use
  expiring reset token;
  |EML|
  ' [NF4]
  :Deliver password-reset link
  to eligible email address;
  |SYS|
  if ($question_x("Link delivered?")) then ($guard_left("[delivered]"))
    |USR|
    ' [NF5]
    :Open valid link and
    submit new password;
    |SYS|
    ' [NF6, BR-PASSWORD-RESET-TOKEN, BR-PASSWORD-STRENGTH]
    :Validate token and
    password strength;
    if ($question("Token valid?")) then ($guard_left("[valid]"))
      while ($question("Password too weak?")) is ($guard_left("[weak — AF-03]"))
        ' [AF-03.1, BR-PASSWORD-STRENGTH]
        :Reject new password and state
        password requirements;
        |USR|
        ' [AF-03.2]
        :Submit another new password;
        |SYS|
      endwhile ($guard("[strong]"))
      if ($question("Account status unchanged?")) then ($guard_left("[unchanged]"))
        ' [NF6, POST1, POST2, POST3, BR-PASSWORD-RESET-TOKEN]
        :Update password and
        invalidate used token;
        stop
      else ($guard_right("[status changed", "— EX-02]"))
        ' [EX-02]
        :Reject password
        reset;
      endif
    else ($guard_right("[invalid, expired", "or used — AF-01]"))
      ' [AF-01.1, BR-PASSWORD-RESET-TOKEN]
      :Reject password
      change;
      ' [AF-01.2]
      :Allow new Forgot
      Password request;
    endif
  else ($guard_right("[not delivered", "— EX-01]"))
    ' [EX-01, BR-PASSWORD-RESET-PRIVACY]
    :Record delivery
    failure without
    exposing account;
  endif
else ($guard_right("[no eligible", "account]"))
endif
|SYS|
stop
@enduml
