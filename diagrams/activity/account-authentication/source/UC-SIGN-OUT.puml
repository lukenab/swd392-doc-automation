@startuml UC-SIGN-OUT
' UC-03 - Log Out | semantic key: UC-SIGN-OUT
' Source: data/use_cases/account-authentication/UC-SIGN-OUT.yml
' Business Rules: BR-LOG-OUT-SESSION
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
!include ../../_shared/activity-style.puml

|USR| $lane_title("User")
|SYS| $lane_title("System")

|USR|
start
' [NF1]
:Request to log out;
|SYS|
if ($question_x("Current session expired?")) then ($guard_left("[still valid]"))
  ' [NF2, POST1]
  :Invalidate the current session
  and its refresh credential;
  if ($question("Session revoked?")) then ($guard_left("[revoked]"))
  else ($guard_right("[cannot be revoked", "— EX-01]"))
    ' [EX-01]
    :Remove the local credentials and report that
    remote revocation could not be confirmed;
    stop
  endif
  ' [NF3, POST2]
  :Remove the local authentication
  credentials and display the
  public log-in page;
else ($guard_right("[already expired", "— AF-01]"))
  ' [AF-01.1, POST2]
  :Remove any remaining local
  authentication credentials;
  ' [AF-01.2]
  :Display the public log-in page;
endif
stop
@enduml
