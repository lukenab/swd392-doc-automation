@startuml UC-ACCOUNT-REGISTER
' UC-01 - Register Account | semantic key: UC-ACCOUNT-REGISTER
' Source: data/use_cases/account-authentication/UC-ACCOUNT-REGISTER.yml
' Business Rules: BR-ACCOUNT-EMAIL-UNIQUE, BR-ACCOUNT-NO-PROJECT-AUTO-MEMBERSHIP, BR-ACCOUNT-VERIFIED-IDENTITY, BR-PASSWORD-STRENGTH
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' Final nodes: F1 = User account active via email verification (POST1, POST2); F2 = account remains
' pending, verification can be requested again (EX-01); F3 = active User account created with Google
' (POST1, POST2 hold once the AF-01.3 account data is persisted); F4 = no User account created
' (EX-02, EX-03 on either path, EX-04). F1 and F3 have the same outcome but end two separate
' registration-method branches with no common last step; merging them would split F4 instead.
' EX-01, EX-02, EX-03 describe no System response, so their guards go straight to the final.
!include ../../_shared/activity-style.puml
|GST| $lane_title("Guest")
|SYS| $lane_title("System")
|EML| $lane_title("Email Service")
|IDP| $lane_title("Identity Provider")

|GST|
start
' [NF1, TRIGGER]
:Open account registration;
|SYS|
if ($question_x("Registration method?")) then ($guard_left("[email and password]"))
  ' [NF2]
  :Request display name,
  email and password;
  |GST|
  ' [NF3]
  :Provide registration
  information;
  |SYS|
  ' [NF4, BR-ACCOUNT-EMAIL-UNIQUE, BR-PASSWORD-STRENGTH]
  :Validate information,
  email uniqueness and
  password strength;
  while ($question("Information invalid?")) is ($guard_left("[invalid — AF-02]"))
    ' [AF-02.1]
    :Request registration information
    again;
    |GST|
    ' [NF3, AF-02]
    :Provide registration
    information;
    |SYS|
  endwhile ($guard("[valid]"))
  ' [NF5]
  :Create pending account;
  if ($question("Account data persisted?")) then ($guard_left("[persisted]"))
    ' [NF6]
    :Request email
    verification message;
    |EML|
    ' [NF7]
    :Deliver verification
    message to submitted
    email address;
    |SYS|
    if ($question_x("Message delivered?")) then ($guard_left("[delivered]"))
      |GST|
      ' [NF8]
      :Open valid
      verification link;
      |SYS|
      ' [NF9, POST1, POST2, BR-ACCOUNT-VERIFIED-IDENTITY, BR-ACCOUNT-NO-PROJECT-AUTO-MEMBERSHIP]
      :Activate User account
      and confirm registration;
      stop
    else ($guard_right("[not delivered", "— EX-01]"))
      |SYS|
      stop
    endif
  else ($guard_right("[not persisted", "— EX-03]"))
  endif
else ($guard_right("[Google", "— AF-01]"))
  |SYS|
  ' [AF-01.1]
  :Redirect Guest to
  Identity Provider;
  |IDP|
  ' [AF-01.2, BR-ACCOUNT-VERIFIED-IDENTITY]
  :Authenticate Guest and
  return verified identity;
  |SYS|
  if ($question_x("Valid verified identity?")) then ($guard_left("[valid]"))
    ' [AF-01.3, BR-ACCOUNT-EMAIL-UNIQUE]
    :Validate email
    uniqueness;
    if ($question("Email address unused?")) then ($guard_left("[unused]"))
      ' [AF-01.3, BR-ACCOUNT-VERIFIED-IDENTITY]
      :Create active
      User account;
      if ($question("Account data persisted?")) then ($guard_left("[persisted]"))
        stop
      else ($guard_right("[not persisted", "— EX-03]"))
      endif
    else ($guard_right("[already registered", "— EX-04]"))
      ' [EX-04, BR-ACCOUNT-EMAIL-UNIQUE]
      :Direct Guest
      to sign-in;
    endif
  else ($guard_right("[no valid identity", "— EX-02]"))
  endif
endif
|SYS|
stop
@enduml
