@startuml UC-ACCOUNT-REGISTER
' UC-01 - Register Account | semantic key: UC-ACCOUNT-REGISTER
' Source: data/use_cases/account-authentication/UC-ACCOUNT-REGISTER.yml
' Business Rules: BR-ACCOUNT-EMAIL-UNIQUE, BR-ACCOUNT-NO-PROJECT-AUTO-MEMBERSHIP,
'                 BR-ACCOUNT-VERIFIED-IDENTITY, BR-PASSWORD-STRENGTH
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
!include ../../_shared/activity-style.puml

|GST| $lane_title("Guest")
|SYS| $lane_title("System")
|EML| $lane_title("Email Service")
|IDP| $lane_title("Identity Provider")

|GST|
start
' [NF1]
:Open account registration and
choose a registration method;
|SYS|
if ($question("Registration method?")) then ($guard_left("[email and password]"))
  ' [NF2]
  :Request the display name,
  email address, and password;
  |GST|
  ' [NF3]
  :Provide the required
  registration information;
  |SYS|
  ' [NF4]
  :Validate the information,
  email uniqueness, and
  password strength;
  while ($question("Information invalid?")) is ($guard_left("[invalid — AF-02]"))
    ' [AF-02.1]
    :Request the registration information again;
    |GST|
    ' [NF3]
    :Provide the registration
    information again;
    |SYS|
  endwhile ($guard("[valid]"))
  ' [NF5]
  :Create a pending account;
  if ($question("Account data persisted?")) then ($guard_left("[persisted]"))
  else ($guard_right("[not persisted", "— EX-03]"))
    ' [EX-03, GUIDE-7.3]
    :Reject the registration so that no account is created;
    stop
  endif
  ' [NF6]
  :Request an email verification
  message for the account;
  |EML|
  ' [NF7]
  :Deliver the verification
  message to the submitted
  email address;
  |SYS|
  if ($question_x("Message delivered?")) then ($guard_left("[delivered]"))
  else ($guard_right("[not delivered", "— EX-01]"))
    ' [EX-01]
    :Keep the account pending so that
    verification can be requested again;
    stop
  endif
  |GST|
  ' [NF8]
  :Open the valid
  verification link;
  |SYS|
  ' [NF9, POST1]
  :Activate the User account
  and confirm registration;
else ($guard_right("[Google", "— AF-01]"))
  ' [AF-01.1]
  :Redirect the Guest to
  the Identity Provider;
  |IDP|
  ' [AF-01.2]
  :Authenticate the Guest and
  return a verified identity;
  |SYS|
  if ($question_x("Valid verified identity?")) then ($guard_left("[valid]"))
  else ($guard_right("[not returned", "— EX-02]"))
    ' [EX-02]
    :Cancel the registration because no
    valid verified identity was returned;
    stop
  endif
  ' [AF-01.3, POST1]
  :Validate email uniqueness
  and create an active
  User account;
endif
stop
@enduml
