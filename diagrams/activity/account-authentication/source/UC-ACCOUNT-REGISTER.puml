@startuml UC-ACCOUNT-REGISTER
' UC-01 - Register Account | semantic key: UC-ACCOUNT-REGISTER
' Source: data/use_cases/account-authentication/UC-ACCOUNT-REGISTER.yml
' Business Rules: BR-ACCOUNT-EMAIL-UNIQUE, BR-ACCOUNT-NO-PROJECT-AUTO-MEMBERSHIP, BR-ACCOUNT-VERIFIED-IDENTITY, BR-PASSWORD-STRENGTH
' Trace comments [ref] identify the YAML element behind each action.
' No title: the Word caption supplies it.
' Final node: one Activity Final in the System lane. Activation (POST1, POST2), account kept
' pending (EX-03 link invalid or expired; EX-01 message not delivered) and registration not
' completed (EX-02) meet at merge nodes before it; the end states are named by the guards.
' Layout: the AF-01 loop decision is drawn in the Guest lane so that the loop exit does not cross
' the flows into and out of the Guest's correction step; the System checks the information.
!include ../../_shared/activity-style.puml
|GST| $lane_title("Guest")
|SYS| $lane_title("System")
|EML| $lane_title("Email Service")

|GST|
start
' [NF1, TRIGGER]
:Choose email/password
registration;
|SYS|
' [NF2]
:Request display name,
email and password;
|GST|
' [NF3]
:Provide registration
information;
|SYS|
' [NF4, BR-ACCOUNT-EMAIL-UNIQUE, BR-PASSWORD-STRENGTH]
:Validate registration
information;
|GST|
while ($question_x("Information invalid?")) is ($guard_right("", "[invalid or used — AF-01]"))
  |SYS|
  ' [AF-01.1]
  :Request correction of
  invalid information;
  |GST|
  ' [AF-01.2]
  :Correct and resubmit
  information;
  |SYS|
  ' [AF-01.3, NF4, BR-ACCOUNT-EMAIL-UNIQUE, BR-PASSWORD-STRENGTH]
  :Revalidate registration
  information;
  |GST|
endwhile ($guard("[valid]"))
|SYS|
' [NF5]
:Create pending User account;
if ($question("Account saved?")) then ($guard_left("[saved]"))
  ' [NF6]
  :Request verification email;
  |EML|
  ' [NF7]
  :Attempt email delivery;
  |SYS|
  if ($question_x("Message delivered?")) then ($guard_left("[delivered]"))
    |GST|
    ' [NF8]
    :Open verification link;
    |SYS|
    if ($question_x("Link valid?")) then ($guard_left("[valid]"))
      ' [NF9, POST1, POST2, BR-ACCOUNT-VERIFIED-IDENTITY, BR-ACCOUNT-NO-PROJECT-AUTO-MEMBERSHIP]
      :Activate account and
      confirm registration;
    else ($guard_right("[invalid or", "expired — EX-03]"))
      ' [EX-03]
      :Keep account pending;
    endif
  else ($guard_right("[not delivered", "— EX-01]"))
    |SYS|
    ' [EX-01]
    :Keep account pending;
  endif
else ($guard_right("[not saved", "— EX-02]"))
  |SYS|
  ' [EX-02, GUIDE-7.3]
  :Report registration
  not completed;
endif
|SYS|
stop
@enduml
