@startuml UC-SIGN-IN
' UC-02 - Log In | semantic key: UC-SIGN-IN
' Source: data/use_cases/account-authentication/UC-SIGN-IN.yml
' Business Rules: BR-ACCOUNT-EMAIL-UNIQUE, BR-ACCOUNT-NO-PROJECT-AUTO-MEMBERSHIP, BR-ACCOUNT-VERIFIED-IDENTITY, BR-AUTH-ACTIVE-ACCOUNT
' Trace comments [ref] identify the YAML element behind each action.
' No title: the Word caption supplies it.
' Final node: one Activity Final in the System lane. Session created (email/password, linked
' Google, first Google log-in), AF-02 hand-off to Forgot Password and EX-01 to EX-06 meet at merge
' nodes before it; the end states are named by the guards. EX-06 and EX-04 are nested decisions
' so that every branch reaches the shared merges.
' Layout: email/password and Google are parallel alternatives; linked-account and
' first-time Google paths are parallel alternatives. Keep Password forgotten? in System.
' AF-01.5 checks email control (EX-06) before email uniqueness (EX-04), so an unverified
' identity never learns whether the address already has an account.
!include ../../_shared/activity-style.puml
|GST| $lane_title("Guest")
|SYS| $lane_title("System")
|IDP| $lane_title("Identity Provider")

|GST|
start
' [NF1, TRIGGER]
:Open log-in page and
choose a method;
|SYS|
if ($question_x("Authentication method?")) then ($guard_left("[email/password]"))
  ' [NF2]
  :Request registered
  email and password;
  if ($question("Password forgotten?")) then ($guard_left("[no]"))
    |GST|
    ' [NF3]
    :Submit credentials;
    |SYS|
    ' [NF4, BR-AUTH-ACTIVE-ACCOUNT]
    :Validate credentials
    and account status;
    if ($question("Credentials accepted?")) then ($guard_left("[valid and active]"))
      ' [NF5, POST1, POST3]
      :Create session and
      display available projects;
    else ($guard_right("[invalid — EX-01", "or inactive — EX-02]"))
      ' [EX-01, EX-02, GUIDE-7.3]
      :Reject log-in;
    endif
  else ($guard_right("[forgotten", "— AF-02]"))
    |SYS|
    ' [AF-02.1]
    :Direct Guest to
    Forgot Password;
  endif
else ($guard_right("[Google", "— AF-01]"))
|SYS|
' [AF-01.1]
:Redirect Guest to
Identity Provider;
|IDP|
' [AF-01.2]
:Authenticate Guest and
return Google identity;
|SYS|
' [AF-01.3, OTHER]
:Validate identity and
find User by subject;
if ($question("Identity valid?")) then ($guard_left("[valid]"))
  if ($question("Linked User found?")) then ($guard_left("[linked]"))
    if ($question("Account active?")) then ($guard_left("[active]"))
      ' [AF-01.4, POST1, POST3, BR-AUTH-ACTIVE-ACCOUNT]
      :Create session and
      display available projects;
    else ($guard_right("[inactive", "— EX-02]"))
      ' [EX-02, BR-AUTH-ACTIVE-ACCOUNT]
      :Reject log-in;
    endif
  else ($guard_right("[not linked", "— AF-01]"))
  ' [AF-01.5, BR-ACCOUNT-VERIFIED-IDENTITY, BR-ACCOUNT-EMAIL-UNIQUE]
  :Check email control
  and email uniqueness;
  if ($question("Email control unverified?")) then ($guard_left("[unverified\n— EX-06]"))
    ' [EX-06, BR-ACCOUNT-VERIFIED-IDENTITY, GUIDE-7.3]
    :Reject first-time
    Google log-in;
  else ($guard("[verified]"))
    if ($question("Email already used?")) then ($guard_left("[used\n— EX-04]"))
      ' [EX-04, BR-ACCOUNT-EMAIL-UNIQUE]
      :Direct Guest to
      existing log-in method;
    else ($guard("[unused — AF-03]"))
      ' [AF-03.1, POST2, BR-ACCOUNT-EMAIL-UNIQUE, BR-ACCOUNT-VERIFIED-IDENTITY]
      :Create active User
      linked to Google subject;
      if ($question("Account saved?")) then ($guard_left("[saved]"))
        ' [AF-03.2, POST1, POST3, BR-ACCOUNT-NO-PROJECT-AUTO-MEMBERSHIP]
        :Create session and
        display available projects;
      else ($guard_right("[not saved", "— EX-05]"))
        ' [EX-05, GUIDE-7.3]
        :Report account
        not created;
      endif
    endif
  endif
  endif
else ($guard_right("[unavailable or", "invalid — EX-03]"))
  ' [EX-03, GUIDE-7.3]
  :Report Google log-in
  not completed;
endif
endif
|SYS|
stop
@enduml
