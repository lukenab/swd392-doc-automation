@startuml UC-PROFILE-UPDATE
' UC-05.2 - Update Personal Profile | semantic key: UC-PROFILE-UPDATE
' Source: data/use_cases/account-authentication/UC-PROFILE-UPDATE.yml
' Business Rules: BR-AUTH-ACTIVE-ACCOUNT, BR-PROFILE-SELF-ACCESS
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' Final nodes: F1 = profile changes saved (postcondition met); F2 = stored profile unchanged
' (EX-01 and AF-01 merge here).
' Layout (2026-10-06): the decision "Submit or cancel?" is drawn in the System lane, where the
' System waits for the User's answer; the guards name the User's choice. In the User lane its merge
' forced a detour across the lanes. The final stays in the System lane.
!include ../../_shared/activity-style.puml
|USR| $lane_title("User")
|SYS| $lane_title("System")

|USR|
start
' [NF1, TRIGGER]
:Open profile editing;
|SYS|
' [NF2]
:Display current
editable profile values;
|USR|
' [NF3]
:Change desired values;
|SYS|
if ($question_x("Submit or cancel?")) then ($guard_left("[submit]"))
  |USR|
  ' [NF3]
  :Submit profile;
  |SYS|
  ' [NF4]
  :Validate profile changes;
  if ($question("Values valid?")) then ($guard_left("[valid]"))
    ' [NF4, POST1, BR-PROFILE-SELF-ACCESS]
    :Save profile changes;
    ' [NF5]
    :Display updated profile;
    stop
  else ($guard_right("[invalid values", "— EX-01]"))
    ' [EX-01, GUIDE-7.3]
    :Reject profile changes;
  endif
else ($guard_right("[cancel before", "saving — AF-01]"))
  |SYS|
  ' [AF-01.1]
  :Discard unsaved changes;
endif
|SYS|
stop
@enduml
