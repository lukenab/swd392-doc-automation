@startuml UC-PROFILE-VIEW
' UC-05.1 - View Personal Profile | semantic key: UC-PROFILE-VIEW
' Source: data/use_cases/account-authentication/UC-PROFILE-VIEW.yml
' Business Rules: BR-AUTH-ACTIVE-ACCOUNT, BR-PROFILE-SELF-ACCESS
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' Final nodes: F1 = profile displayed without modification (postcondition met); F2 = profile not
' displayed (EX-01). EX-01 describes no System response, so its guard goes straight to F2.
!include ../../_shared/activity-style.puml

|USR| $lane_title("User")
|SYS| $lane_title("System")

|USR|
start
' [NF1, TRIGGER]
:Open personal profile page;
|SYS|
' [NF2, BR-PROFILE-SELF-ACCESS]
:Retrieve profile of
authenticated User;
if ($question("Profile available?")) then ($guard_left("[available]"))
  ' [NF3, POST1, OTHER]
  :Display profile and non-sensitive
  account information;
  stop
else ($guard_right("[temporarily unavailable", "— EX-01]"))
  |SYS|
  stop
endif
@enduml
