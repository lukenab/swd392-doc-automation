@startuml UC-PROJECT-MEMBER-ADD
' UC-09.2 - Add Project Member | semantic key: UC-PROJECT-MEMBER-ADD
' Source: data/use_cases/project-membership/UC-PROJECT-MEMBER-ADD.yml
' Business Rules: BR-ACTIVE-USER-REQUIRED, BR-PROJECT-OWNER-ADMINISTRATION
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' Final nodes: F1 = membership created (postconditions met); F2 = no membership change (AF-01, EX-01).
!include ../../_shared/activity-style.puml
|OWN| $lane_title("Project Owner")
|SYS| $lane_title("System")

|OWN|
start
' [NF1]
:Choose to add a project member;
|SYS|
' [NF2]
:Request existing User account;
|OWN|
' [NF3]
:Select User and confirm addition;
|SYS|
' [NF4, BR-ACTIVE-USER-REQUIRED]
:Verify account
status and membership;
if ($question("Already a member?")) then ($guard_left("[not a member]"))
  if ($question("Account still active?")) then ($guard_left("[active]"))
    ' [NF5, POST1]
    :Create membership
    and refresh list;
    ' [POST2]
    :Record change in
    activity history;
    stop
  else ($guard_right("[became inactive", "— EX-01]"))
    ' [EX-01, GUIDE-7.3]
    :Reject member addition;
  endif
else ($guard_right("[already a member", "— AF-01]"))
  ' [AF-01.1]
  :Report no new
  membership required;
endif
stop
@enduml
