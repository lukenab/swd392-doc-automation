@startuml UC-PROJECT-DASHBOARD-VIEW
' UC-07 - View Project Dashboard | semantic key: UC-PROJECT-DASHBOARD-VIEW
' Source: data/use_cases/project-membership/UC-PROJECT-DASHBOARD-VIEW.yml
' Business Rules: BR-PROJECT-MEMBER-ACCESS, BR-PROJECT-ARCHIVED-READ-ONLY
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' One Activity Final shared by all paths (team decision 2026-10-05; UML allows one or several). It
' is reached after the dashboard is displayed, read-only when archived (NF4 or AF-01; postconditions
' met), or after EX-01 (access denied, nothing displayed).
!include ../../_shared/activity-style.puml

|USR| $lane_title("User")
|SYS| $lane_title("System")

|USR|
start
' [NF1]
:Select a project;
|SYS|
' [NF2, BR-PROJECT-MEMBER-ACCESS]
:Verify active project membership;
if ($question("Project and membership exist?")) then ($guard_left("[exist]"))
  ' [NF3]
  :Retrieve project, member
  and Sprint summary;
  if ($question_x("Project archived?")) then ($guard_left("[active]"))
    ' [NF4, POST1]
    :Display project dashboard;
  else ($guard_right("[archived", "— AF-01]"))
    ' [AF-01.1, BR-PROJECT-ARCHIVED-READ-ONLY]
    :Display read-only dashboard;
  endif
else ($guard_right("[project or membership", "removed — EX-01]"))
  |SYS|
  ' [EX-01, GUIDE-7.3]
  :Deny dashboard access;
endif
|SYS|
stop
@enduml
