@startuml UC-PROJECT-CREATE
' UC-06 - Create Project | semantic key: UC-PROJECT-CREATE
' Source: data/use_cases/project-membership/UC-PROJECT-CREATE.yml
' Business Rules: BR-ACTIVE-USER-REQUIRED, BR-PROJECT-ONE-OWNER
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' Final nodes: F1 = creation rejected, no project created (EX-01); F2 = project created and
' initialized (postconditions met).
!include ../../_shared/activity-style.puml

|USR| $lane_title("User")
|SYS| $lane_title("System")

|USR|
start
' [NF1]
:Start project creation;
|SYS|
' [NF2]
:Request the project name,
description, and planned dates;
|USR|
' [NF3]
:Provide the required project
information and confirm creation;
|SYS|
' [NF4]
:Validate the submitted information;
while ($question("Information missing or invalid?")) is ($guard_left("[invalid — AF-01]"))
  ' [AF-01.1]
  :Identify the invalid information;
  |USR|
  ' [AF-01.2]
  :Correct the information and submit it again;
  |SYS|
endwhile ($guard("[valid]"))
' [NF5, POST1, POST2, BR-PROJECT-ONE-OWNER]
:Create the project and assign
ownership to the User;
if ($question("Project data persisted?")) then ($guard_left("[persisted]"))
else ($guard_right("[not persisted", "— EX-01]"))
  ' [EX-01, GUIDE-7.3]
  :Reject the project creation because the data cannot be persisted;
  stop
endif
' [NF6, POST3]
:Initialize the Product Backlog
and default Sprint Board;
stop
@enduml
