@startuml UC-PROJECT-CREATE
' UC-06 - Create Project | semantic key: UC-PROJECT-CREATE
' Source: data/use_cases/project-membership/UC-PROJECT-CREATE.yml
' Business Rules: BR-ACTIVE-USER-REQUIRED, BR-PROJECT-ONE-OWNER
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' Final nodes: F1 = project created and initialized (postconditions met); F2 = project not created
' (EX-01). POST1-POST2 are traced on the [persisted] path only. The System response to EX-01 is not
' specified (Needs clarification); "Reject project creation" follows guideline section 7.3.
!include ../../_shared/activity-style.puml

|USR| $lane_title("User")
|SYS| $lane_title("System")

|USR|
start
' [NF1]
:Start project creation;
|SYS|
' [NF2]
:Request name, description
and planned dates;
|USR|
' [NF3]
:Enter project
information and confirm;
|SYS|
' [NF4]
:Validate project information;
while ($question("Information missing or invalid?")) is ($guard_left("[invalid — AF-01]"))
  ' [AF-01.1]
  :Identify invalid information;
  |USR|
  ' [AF-01.2]
  :Correct and resubmit information;
  |SYS|
endwhile ($guard("[valid]"))
' [NF5, BR-PROJECT-ONE-OWNER]
:Create project
with User as owner;
if ($question("Project data persisted?")) then ($guard_left("[persisted]"))
  ' [NF6, POST1, POST2, POST3]
  :Initialize Product Backlog
  and default Sprint Board;
  stop
else ($guard_right("[persistence", "failed — EX-01]"))
  |SYS|
  ' [EX-01, GUIDE-7.3]
  :Reject project creation;
  stop
endif
@enduml
