@startuml UC-SPRINT-PLAN
' UC-19 - Plan Sprint | semantic key: UC-SPRINT-PLAN
' Source: data/use_cases/sprint-management/UC-SPRINT-PLAN.yml
' Business Rules: BR-SPRINT-GOAL-REQUIRED, BR-SPRINT-DATE-RANGE, BR-BACKLOG-ITEM-READY, BR-SPRINT-ONE-DRAFT
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' Final nodes: F1 = Draft Sprint and initial Sprint Backlog created (postconditions met); F2 = Sprint
' not saved because its date range conflicts with another Sprint (EX-01).
!include ../../_shared/activity-style.puml

|PRO| $lane_title("Product Owner")
|SYS| $lane_title("System")
|DEV| $lane_title("Developer")

|PRO|
start
' [NF1, BR-SPRINT-GOAL-REQUIRED, BR-SPRINT-DATE-RANGE]
:Propose Sprint Goal
and date range;
|SYS|
' [NF2, BR-BACKLOG-ITEM-READY]
:Display ordered Product Backlog
Items ready for selection;
|PRO|
' [NF3]
:Propose backlog items
supporting Sprint Goal;
|DEV|
' [NF4]
:Review capacity, estimates
and item readiness;
|SYS|
while ($question_x("Selected item not ready?")) is ($guard_left("[not ready — AF-01]"))
  ' [AF-01.1, BR-BACKLOG-ITEM-READY]
  :Identify missing readiness information;
  |PRO|
  ' [AF-01.2]
  :Refine or deselect item
with Developers;
  |SYS|
endwhile ($guard("[all ready]"))
|PRO|
' [NF5]
:Confirm Sprint Goal and
selected items with Developer;
|SYS|
if ($question_x("Date range conflicts?")) then ($guard_left("[no conflict]"))
  ' [NF6, POST1, POST2, BR-SPRINT-ONE-DRAFT]
  :Create Draft Sprint and
  initial Sprint Backlog;
  stop
else ($guard_right("[conflicts with another", "Sprint — EX-01]"))
  |SYS|
  ' [EX-01, GUIDE-7.3]
  :Reject Draft Sprint creation;
  stop
endif
@enduml
