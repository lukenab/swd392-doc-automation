@startuml UC-SPRINT-CANCEL
' UC-22 - Cancel Sprint | semantic key: UC-SPRINT-CANCEL
' Source: data/use_cases/sprint-management/UC-SPRINT-CANCEL.yml
' Business Rules: BR-SPRINT-CANCEL-PO-ONLY, BR-SPRINT-INCOMPLETE-RETURN-BACKLOG
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' Final nodes: F1 = Sprint cancelled (postconditions met); F2 = Sprint unchanged (EX-01, AF-01).
!include ../../_shared/activity-style.puml
|PRO| $lane_title("Product Owner")
|SYS| $lane_title("System")

|PRO|
start
' [NF1, BR-SPRINT-CANCEL-PO-ONLY]
:Request Sprint cancellation
and provide a reason;
|SYS|
if ($question_x("Sprint still active?")) then ($guard_left("[active]"))
  ' [NF2]
  :Display the impact on selected
  and completed work;
  |PRO|
  if ($question_x("Confirm the cancellation?")) then ($guard_left("[confirm]"))
    ' [NF3]
    :Confirm the cancellation;
    |SYS|
    ' [NF4, POST1, POST2, BR-SPRINT-INCOMPLETE-RETURN-BACKLOG]
    :Cancel the Sprint and return
    incomplete items to the
    Product Backlog;
    ' [NF5]
    :Record the cancellation
    reason and timestamp;
    stop
  else ($guard_right("[continue the", "Sprint — AF-01]"))
    |PRO|
    ' [AF-01.1]
    :Cancel the
    confirmation;
    |SYS|
    ' [AF-01.2]
    :Leave the Sprint
    unchanged;
  endif
else ($guard_right("[already completed", "or cancelled — EX-01]"))
  ' [EX-01, GUIDE-7.3]
  :Reject the cancellation
  because the Sprint is
  no longer active;
endif
|SYS|
stop
@enduml
