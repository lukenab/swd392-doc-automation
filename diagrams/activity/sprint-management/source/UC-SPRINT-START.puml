@startuml UC-SPRINT-START
' UC-20 - Start Sprint | semantic key: UC-SPRINT-START
' Source: data/use_cases/sprint-management/UC-SPRINT-START.yml
' Business Rules: BR-SPRINT-ONE-ACTIVE, BR-SPRINT-GOAL-REQUIRED, BR-SPRINT-DATE-RANGE
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' Final nodes: F1 = start rejected, Sprint stays in Draft status (EX-01); F2 = Sprint active,
' Sprint Board open, start time recorded (postconditions met).
' AF-02: after the violated constraint is reported the Sprint remains in Draft status; the
' Product Owner updates the selection again and the loop returns to the revalidation result.
!include ../../_shared/activity-style.puml

|PRO| $lane_title("Product Owner")
|SYS| $lane_title("System")
|DEV| $lane_title("Developer")

|PRO|
start
' [NF1]
:Request to start Draft Sprint;
|SYS|
' [NF2, BR-SPRINT-GOAL-REQUIRED, BR-SPRINT-DATE-RANGE, BR-SPRINT-ONE-ACTIVE]
:Validate Sprint Goal, dates, selected
work and active-Sprint constraint;
if ($question("Another Sprint active?")) then ($guard_left("[none active]"))
else ($guard_right("[already active", "— EX-01]"))
  ' [EX-01, BR-SPRINT-ONE-ACTIVE, GUIDE-7.3]
  :Reject Sprint start;
  stop
endif
|DEV|
' [NF3]
:Confirm selected work is
understood and executable;
|PRO|
while ($question_x("Change the selection?")) is ($guard_left("[change — AF-01]"))
  ' [AF-01.1]
  :Update selected backlog items;
  |SYS|
  ' [AF-01.2, BR-SPRINT-GOAL-REQUIRED, BR-SPRINT-DATE-RANGE]
  :Revalidate Sprint before activation;
  while ($question("Revalidation failed?")) is ($guard_left("[fails — AF-02]"))
    ' [AF-02.1]
    :Report violated constraint;
    |PRO|
    ' [AF-02.2]
    :Update selected backlog items again;
    |SYS|
  endwhile ($guard("[passes]"))
  |PRO|
endwhile ($guard("[no change]"))
' [NF4]
:Confirm Sprint activation;
|SYS|
' [NF5, POST1, POST2]
:Mark Sprint active and
open its Sprint Board;
' [OTHER]
:Record Sprint start time
in activity history;
stop
@enduml
