@startuml UC-WORK-ITEM-STATUS-UPDATE
' UC-26 - Update Work Item Status | semantic key: UC-WORK-ITEM-STATUS-UPDATE
' Source: data/use_cases/sprint-work/UC-WORK-ITEM-STATUS-UPDATE.yml
' Business Rules: BR-SPRINT-TASK-DEVELOPER, BR-WORK-ITEM-STATUS
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' Final nodes: F1 = status updated, board refreshed and change recorded (postconditions met);
' F2 = status change rejected, work item status unchanged (EX-01).
!include ../../_shared/activity-style.puml
|DEV| $lane_title("Developer")
|SYS| $lane_title("System")

|DEV|
start
' [NF1, OTHER]
:Select new status
or move card;
|SYS|
' [NF2, BR-WORK-ITEM-STATUS, BR-SPRINT-TASK-DEVELOPER]
:Validate requested transition
and actor permission;
while ($question("Done with missing required information?")) is ($guard_left("[missing — AF-01]"))
  ' [AF-01.1]
  :Identify missing information;
  |DEV|
  ' [AF-01.2]
  :Complete information or choose another status;
  |SYS|
  ' [AF-01.3, BR-WORK-ITEM-STATUS]
  :Validate requested transition again;
endwhile ($guard("[complete]"))
if ($question("Status still available?")) then ($guard_left("[available]"))
  ' [NF3, POST1]
  :Update work item status;
  ' [NF4, POST2]
  :Refresh Sprint Board
  and record change;
  stop
else ($guard_right("[no longer", "available — EX-01]"))
  ' [EX-01, BR-WORK-ITEM-STATUS, GUIDE-7.3]
  :Reject status change;
  stop
endif
@enduml
