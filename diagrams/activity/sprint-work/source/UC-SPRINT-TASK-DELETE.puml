@startuml UC-SPRINT-TASK-DELETE
' UC-24.5 - Delete Sprint Task | semantic key: UC-SPRINT-TASK-DELETE
' Source: data/use_cases/sprint-work/UC-SPRINT-TASK-DELETE.yml
' Business Rules: BR-SPRINT-TASK-ACTIVE-SPRINT, BR-SPRINT-TASK-DEVELOPER
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' One Activity Final shared by all paths (team decision 2026-10-06; UML allows one or several). It
' is reached after the task is deleted and recorded (postconditions met) or with the task unchanged:
' deletion cancelled (AF-02), dependencies must be removed first (AF-01) or deletion rejected
' (EX-01).
!include ../../_shared/activity-style.puml
|DEV| $lane_title("Developer")
|SYS| $lane_title("System")

|DEV|
start
' [NF1, BR-SPRINT-TASK-DEVELOPER]
:Select Sprint Task
and request deletion;
|SYS|
if ($question_x("Task execution started?")) then ($guard_left("[not started]"))
  if ($question("Dependent tasks exist?")) then ($guard_left("[none]"))
    ' [NF2]
    :Display dependency impact
    and ask for confirmation;
    |DEV|
    if ($question_x("Confirm deletion?")) then ($guard_left("[confirm]"))
      ' [NF3]
      :Confirm deletion;
      |SYS|
      ' [NF4, POST1, POST2, OTHER]
      :Delete task and
      record action;
    else ($guard_right("[cancel", "— AF-02]"))
      |SYS|
      ' [AF-02.1]
      :Leave Sprint Task
      unchanged;
    endif
  else ($guard_right("[dependent tasks", "— AF-01]"))
    |SYS|
    ' [AF-01.1]
    :Require dependency
    removal first;
  endif
else ($guard_right("[in execution", "— EX-01]"))
  |SYS|
  ' [EX-01, GUIDE-7.3]
  :Reject Sprint
  Task deletion;
endif
|SYS|
stop
@enduml
