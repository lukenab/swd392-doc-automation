@startuml UC-TASK-DEPENDENCY-ADD
' UC-24.6 - Add Task Dependency | semantic key: UC-TASK-DEPENDENCY-ADD
' Source: data/use_cases/sprint-work/UC-TASK-DEPENDENCY-ADD.yml
' Business Rules: BR-SPRINT-TASK-DEVELOPER, BR-TASK-DEPENDENCY-ACYCLIC, BR-TASK-NO-SELF-DEPENDENCY, BR-TASK-DEPENDENCY-SAME-PROJECT
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' Final nodes: F1 = dependency stored (postconditions met); F2 = dependency rejected, nothing
' stored (EX-01, EX-02).
!include ../../_shared/activity-style.puml
|DEV| $lane_title("Developer")
|SYS| $lane_title("System")

|DEV|
start
' [NF1, BR-SPRINT-TASK-DEVELOPER]
:Open Sprint Task and
choose to add dependency;
|SYS|
' [NF2, BR-TASK-DEPENDENCY-SAME-PROJECT]
:Display eligible tasks
in same project;
|DEV|
' [NF3]
:Select dependency target
and confirm relationship;
|SYS|
' [NF4]
:Validate task dependency;
if ($question("Same task selected?")) then ($guard_left("[different task]"))
  if ($question("Would it create a cycle?")) then ($guard_left("[no cycle]"))
    ' [NF4, POST1]
    :Store task dependency;
    stop
  else ($guard_right("[direct or indirect", "cycle — EX-01]"))
    ' [EX-01, BR-TASK-DEPENDENCY-ACYCLIC, GUIDE-7.3]
    :Reject task dependency;
  endif
else ($guard_right("[same task", "— EX-02]"))
  ' [EX-02, BR-TASK-NO-SELF-DEPENDENCY, GUIDE-7.3]
  :Reject task dependency;
endif
stop
@enduml
