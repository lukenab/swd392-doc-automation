@startuml UC-SPRINT-TASK-CREATE
' UC-24.2 - Create Sprint Task | semantic key: UC-SPRINT-TASK-CREATE
' Source: data/use_cases/sprint-work/UC-SPRINT-TASK-CREATE.yml
' Business Rules: BR-SPRINT-TASK-ACTIVE-SPRINT, BR-SPRINT-TASK-DEVELOPER
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' One Activity Final shared by all paths (team decision 2026-10-06; UML allows one or several). It
' is reached after the Sprint Task is created and recorded (postconditions met) or after EX-01
' (creation rejected, no task created).
!include ../../_shared/activity-style.puml

|DEV| $lane_title("Developer")
|SYS| $lane_title("System")

|DEV|
start
' [NF1, BR-SPRINT-TASK-DEVELOPER]
:Choose to create task
for Sprint Backlog Item;
|SYS|
' [NF2]
:Request task title and
initial work details;
|DEV|
' [NF3]
:Provide task information
and confirm creation;
|SYS|
' [NF4]
:Validate task information;
while ($question("Information missing or invalid?")) is ($guard_left("[invalid — AF-01]"))
  ' [AF-01.1]
  :Identify missing or invalid task information;
  |DEV|
  ' [AF-01.2]
  :Correct and resubmit information;
  |SYS|
endwhile ($guard("[valid]"))
if ($question("Backlog Item still in active Sprint?")) then ($guard_left("[still in Sprint]"))
  ' [NF4, POST1, BR-SPRINT-TASK-ACTIVE-SPRINT]
  :Store Sprint Task for selected
  Product Backlog Item;
  ' [POST2]
  :Record creation in
  work item activity;
else ($guard_right("[no longer in active", "Sprint — EX-01]"))
  ' [EX-01, BR-SPRINT-TASK-ACTIVE-SPRINT, GUIDE-7.3]
  :Reject Sprint Task creation;
endif
|SYS|
stop
@enduml
