@startuml UC-SUBTASK-CREATE
' UC-27.2 - Create Subtask | semantic key: UC-SUBTASK-CREATE
' Source: data/use_cases/sprint-work/UC-SUBTASK-CREATE.yml
' Business Rules: BR-SPRINT-TASK-ACTIVE-SPRINT, BR-SPRINT-TASK-DEVELOPER, BR-SUBTASK-SINGLE-LEVEL
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' Final nodes: F1 = subtask created and parent progress recalculated (postconditions met);
' F2 = creation rejected, no subtask created (EX-01).
!include ../../_shared/activity-style.puml
|DEV| $lane_title("Developer")
|SYS| $lane_title("System")

|DEV|
start
' [NF1, BR-SPRINT-TASK-DEVELOPER]
:Open Sprint Task and
choose to add subtask;
|SYS|
' [NF2]
:Request subtask's work
details and optional assignee;
|DEV|
' [NF3]
:Provide information
and confirm creation;
|SYS|
' [NF4]
:Validate subtask;
if ($question("Parent is a Sprint Task?")) then ($guard_left("[Sprint Task]"))
  ' [NF4, POST1]
  :Store and display
  new subtask;
  ' [POST2]
  :Recalculate parent-task progress;
  stop
else ($guard_right("[parent is a", "subtask — EX-01]"))
  ' [EX-01, BR-SUBTASK-SINGLE-LEVEL, GUIDE-7.3]
  :Reject subtask creation;
  stop
endif
@enduml
