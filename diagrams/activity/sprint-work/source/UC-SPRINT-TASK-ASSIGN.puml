@startuml UC-SPRINT-TASK-ASSIGN
' UC-24.4 - Assign Sprint Task | semantic key: UC-SPRINT-TASK-ASSIGN
' Source: data/use_cases/sprint-work/UC-SPRINT-TASK-ASSIGN.yml
' Business Rules: BR-SPRINT-TASK-ACTIVE-SPRINT, BR-SPRINT-TASK-DEVELOPER
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' One Activity Final shared by all paths (team decision 2026-10-06; UML allows one or several). It
' is reached after the assignment is saved and recorded (postconditions met), after the current
' assignment is cleared (AF-01) or after EX-01 (assignment rejected, unchanged).
!include ../../_shared/activity-style.puml
|DEV| $lane_title("Developer")
|SYS| $lane_title("System")

|DEV|
start
' [NF1, BR-SPRINT-TASK-DEVELOPER]
:Open task assignment control;
|SYS|
' [NF2, BR-SPRINT-TASK-DEVELOPER]
:Display eligible Developers;
|DEV|
if ($question_x("Assign or clear?")) then ($guard_left("[assign]"))
  ' [NF3]
  :Select assignee and
  confirm assignment;
  |SYS|
  if ($question_x("Assignee still active?")) then ($guard_left("[active]"))
    ' [NF4, POST1, POST2]
    :Save assignment
    and record change;
  else ($guard_right("[assignee no longer", "active — EX-01]"))
    ' [EX-01, GUIDE-7.3]
    :Reject task assignment;
  endif
else ($guard_right("[clear current", "assignment — AF-01]"))
  |SYS|
  ' [AF-01.1]
  :Mark Sprint Task
  as unassigned;
endif
|DEV|
stop
@enduml
