@startuml UC-TASK-DEPENDENCY-REMOVE
' UC-24.7 - Remove Task Dependency | semantic key: UC-TASK-DEPENDENCY-REMOVE
' Source: data/use_cases/sprint-work/UC-TASK-DEPENDENCY-REMOVE.yml
' Business Rules: BR-SPRINT-TASK-DEVELOPER, BR-TASK-DEPENDENCY-SAME-PROJECT
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' One Activity Final shared by all paths (team decision 2026-10-06; UML allows one or several). It
' is reached after the dependency is removed and recorded (postconditions met) or with no removal:
' request rejected because the dependency was already removed (EX-01) or cancelled (AF-01).
!include ../../_shared/activity-style.puml
|DEV| $lane_title("Developer")
|SYS| $lane_title("System")

|DEV|
start
' [NF1, BR-SPRINT-TASK-DEVELOPER]
:Open Sprint Task and select
existing dependency;
' [NF2]
:Request dependency removal;
|SYS|
' [NF3]
:Request confirmation and
display affected tasks;
|DEV|
if ($question_x("Confirm removal?")) then ($guard_left("[confirm]"))
  ' [NF4]
  :Confirm removal;
  |SYS|
  if ($question_x("Dependency still exists?")) then ($guard_left("[exists]"))
    ' [NF5, POST1, POST2]
    :Remove relationship
    and record change;
  else ($guard_right("[already", "removed — EX-01]"))
    ' [EX-01, GUIDE-7.3]
    :Reject dependency removal;
  endif
else ($guard_right("[cancel", "— AF-01]"))
  |SYS|
  ' [AF-01.1]
  :Leave dependency
  unchanged;
endif
|SYS|
stop
@enduml
