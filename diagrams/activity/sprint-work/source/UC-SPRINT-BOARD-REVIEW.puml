@startuml UC-SPRINT-BOARD-REVIEW
' UC-23 - Review Sprint Board | semantic key: UC-SPRINT-BOARD-REVIEW
' Source: data/use_cases/sprint-work/UC-SPRINT-BOARD-REVIEW.yml
' Business Rules: BR-PROJECT-MEMBER-ACCESS
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
!include ../../_shared/activity-style.puml
|USR| $lane_title("User")
|SYS| $lane_title("System")

|USR|
start
' [NF1, BR-PROJECT-MEMBER-ACCESS]
:Open the Sprint Board;
|SYS|
if ($question_x("Active Sprint exists?")) then ($guard_left("[active Sprint]"))
  ' [NF2]
  :Load the active Sprint
  and its work items;
  if ($question("Sprint data available?")) then ($guard_left("[available]"))
  else ($guard_right("[unavailable", "— EX-01]"))
    ' [EX-01, GUIDE-7.3]
    :Report that the Sprint Board cannot be loaded at this time;
    stop
  endif
  ' [NF3]
  :Group the items by their
  current workflow status;
  ' [NF4, POST1]
  :Display item priority, assignee,
  estimate and status;
  stop
else ($guard_right("[no active Sprint", "— AF-01]"))
  ' [AF-01.1]
  :Display that no Sprint is active;
  if ($question("Previous Sprint information available?")) then ($guard_left("[available]"))
    ' [AF-01.2]
    :Offer access to previous
    Sprint information;
  else ($guard_right("[not", "available]"))
  endif
  stop
endif
@enduml
