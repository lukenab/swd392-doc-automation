@startuml UC-SPRINT-TASK-VIEW
' UC-24.1 - View Sprint Task | semantic key: UC-SPRINT-TASK-VIEW
' Source: data/use_cases/sprint-work/UC-SPRINT-TASK-VIEW.yml
' Business Rules: BR-PROJECT-MEMBER-ACCESS
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' Final nodes: F1 = Sprint Task displayed (POST1); F2 = selected task no longer available, nothing
' displayed (EX-01). The UC does not describe a response to EX-01, so no action is drawn
' (Needs clarification).
!include ../../_shared/activity-style.puml
|USR| $lane_title("User")
|SYS| $lane_title("System")

|USR|
start
' [NF1, BR-PROJECT-MEMBER-ACCESS]
:Select Sprint Task;
|SYS|
' [NF2]
:Retrieve task details, assignment,
dependencies and activity summary;
if ($question("Task still available?")) then ($guard_left("[available]"))
  ' [NF3, POST1]
  :Display Sprint Task;
  stop
else ($guard_right("[no longer", "available — EX-01]"))
  |SYS|
  stop
endif
@enduml
