@startuml UC-SUBTASK-UPDATE
' UC-27.3 - Update Subtask | semantic key: UC-SUBTASK-UPDATE
' Source: data/use_cases/sprint-work/UC-SUBTASK-UPDATE.yml
' Business Rules: BR-SPRINT-TASK-ACTIVE-SPRINT, BR-SPRINT-TASK-DEVELOPER, BR-SUBTASK-SINGLE-LEVEL
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
!include ../../_shared/activity-style.puml
|DEV| $lane_title("Developer")
|SYS| $lane_title("System")

|DEV|
start
' [NF1, BR-SPRINT-TASK-DEVELOPER]
:Open a subtask for editing;
|SYS|
' [NF2]
:Display its current
editable values;
|DEV|
if ($question_x("Submit the changes?")) then ($guard_left("[submit]"))
  ' [NF3]
  :Revise the information
  and submit the subtask;
  |SYS|
  ' [NF4]
  :Validate the changes;
  if ($question_x("Parent still in the active Sprint?")) then ($guard_left("[in the active Sprint]"))
  else ($guard_right("[no longer in the", "active Sprint — EX-01]"))
    ' [EX-01, BR-SPRINT-TASK-ACTIVE-SPRINT, GUIDE-7.3]
    :Reject the update because the parent task left the active Sprint;
    stop
  endif
  ' [NF4, POST1]
  :Save the changes;
  if ($question("Parent progress affected?")) then ($guard_left("[affected]"))
    ' [POST2]
    :Recalculate parent-task progress;
  else ($guard_right("[not", "affected]"))
  endif
  stop
else ($guard_right("[cancel", "editing — AF-01]"))
  |SYS|
  ' [AF-01.1]
  :Keep the subtask
  unchanged;
  stop
endif
@enduml
