@startuml UC-SPRINT-TASK-UPDATE
' UC-24.3 - Update Sprint Task | semantic key: UC-SPRINT-TASK-UPDATE
' Source: data/use_cases/sprint-work/UC-SPRINT-TASK-UPDATE.yml
' Business Rules: BR-SPRINT-TASK-ACTIVE-SPRINT, BR-SPRINT-TASK-DEVELOPER
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' Final nodes: F1 = changes saved and recorded (postconditions met); F2 = task unchanged: update
' rejected (EX-01) or unsaved changes discarded (AF-01).
!include ../../_shared/activity-style.puml
|DEV| $lane_title("Developer")
|SYS| $lane_title("System")

|DEV|
start
' [NF1, BR-SPRINT-TASK-DEVELOPER]
:Open Sprint Task for editing;
|SYS|
' [NF2]
:Display editable
task information;
|DEV|
if ($question_x("Submit changes?")) then ($guard_left("[submit]"))
  ' [NF3]
  :Update desired values
  and submit task;
  |SYS|
  ' [NF4]
  :Validate task changes;
  if ($question("Task still in active Sprint?")) then ($guard_left("[in active Sprint]"))
    ' [NF4, POST1]
    :Save task changes;
    ' [POST2]
    :Record update in
    work item activity;
    stop
  else ($guard_right("[no longer in", "active Sprint — EX-01]"))
    ' [EX-01, BR-SPRINT-TASK-ACTIVE-SPRINT, GUIDE-7.3]
    :Reject Sprint Task update;
  endif
else ($guard_right("[cancel before", "saving — AF-01]"))
  |SYS|
  ' [AF-01.1]
  :Discard unsaved
  task changes;
endif
|SYS|
stop
@enduml
