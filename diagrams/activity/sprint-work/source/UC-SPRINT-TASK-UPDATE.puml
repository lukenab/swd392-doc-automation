@startuml UC-SPRINT-TASK-UPDATE
' UC-24.3 - Update Sprint Task | semantic key: UC-SPRINT-TASK-UPDATE
' Source: data/use_cases/sprint-work/UC-SPRINT-TASK-UPDATE.yml
' Business Rules: BR-SPRINT-TASK-ACTIVE-SPRINT, BR-SPRINT-TASK-DEVELOPER
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' Final nodes: F1 = changes saved (postconditions met); F2 = task unchanged (EX-01, AF-01).
!include ../../_shared/activity-style.puml
|DEV| $lane_title("Developer")
|SYS| $lane_title("System")

|DEV|
start
' [NF1, BR-SPRINT-TASK-DEVELOPER]
:Open a Sprint Task for editing;
|SYS|
' [NF2]
:Display the editable
task information;
|DEV|
if ($question_x("Submit the changes?")) then ($guard_left("[submit]"))
  ' [NF3]
  :Update the desired values
  and submit the task;
  |SYS|
  ' [NF4]
  :Validate the changes;
  if ($question_x("Task still in the active Sprint?")) then ($guard_left("[in the active Sprint]"))
    ' [NF4, POST1]
    :Save the changes;
    ' [POST2]
    :Record the update in
    work item activity;
    stop
  else ($guard_right("[no longer in the", "active Sprint — EX-01]"))
    ' [EX-01, BR-SPRINT-TASK-ACTIVE-SPRINT, GUIDE-7.3]
    :Reject the update
    because the task is no
    longer in the active Sprint;
  endif
else ($guard_right("[cancel before", "saving — AF-01]"))
  |SYS|
  ' [AF-01.1]
  :Discard the unsaved
  task changes;
endif
|DEV|
stop
@enduml
