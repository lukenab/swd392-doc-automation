@startuml UC-SUBTASK-DELETE
' UC-27.5 - Delete Subtask | semantic key: UC-SUBTASK-DELETE
' Source: data/use_cases/sprint-work/UC-SUBTASK-DELETE.yml
' Business Rules: BR-SPRINT-TASK-ACTIVE-SPRINT, BR-SPRINT-TASK-DEVELOPER
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' One Activity Final shared by all paths (team decision 2026-10-06; UML allows one or several). It
' is reached after the subtask is removed and parent progress recalculated (postconditions met) or
' with the subtask unchanged (EX-01 rejection, AF-01 cancellation).
!include ../../_shared/activity-style.puml
|DEV| $lane_title("Developer")
|SYS| $lane_title("System")

|DEV|
start
' [NF1, BR-SPRINT-TASK-DEVELOPER]
:Select incomplete subtask
and request deletion;
|SYS|
' [NF2]
:Request confirmation;
|DEV|
if ($question_x("Confirm deletion?")) then ($guard_left("[confirm]"))
  ' [NF3]
  :Confirm deletion;
  |SYS|
  if ($question_x("Deletion still allowed?")) then ($guard_left("[allowed]"))
    ' [NF4, POST1, POST2, OTHER]
    :Remove subtask and recalculate
    parent-task progress;
  else ($guard_right("[completed or", "Sprint ended — EX-01]"))
    ' [EX-01, BR-SPRINT-TASK-ACTIVE-SPRINT, GUIDE-7.3]
    :Reject subtask deletion;
  endif
else ($guard_right("[cancel", "— AF-01]"))
  |SYS|
  ' [AF-01.1]
  :Leave subtask
  unchanged;
endif
|DEV|
stop
@enduml
