@startuml UC-BACKLOG-ITEM-UPDATE
' UC-15.3 - Update Product Backlog Item | semantic key: UC-BACKLOG-ITEM-UPDATE
' Source: data/use_cases/product-backlog/UC-BACKLOG-ITEM-UPDATE.yml
' Business Rules: BR-PRODUCT-OWNER-BACKLOG, BR-PROJECT-ARCHIVED-READ-ONLY
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' One Activity Final shared by all paths (team decision 2026-10-05; UML allows one or several). It
' is reached after the changes are saved and recorded (postconditions met) or after EX-01 (update
' rejected, item unchanged).
!include ../../_shared/activity-style.puml

|PRO| $lane_title("Product Owner")
|SYS| $lane_title("System")

|PRO|
start
' [NF1]
:Open Product Backlog Item
for editing;
|SYS|
' [NF2]
:Display editable item values;
if ($question("Item in active Sprint?")) then ($guard_left("[not in active Sprint]"))
else ($guard_right("[in active Sprint", "— AF-01]"))
  ' [AF-01.1]
  :Limit changes invalidating
  active Sprint planning;
endif
|PRO|
' [NF3]
:Revise values and submit item;
|SYS|
' [NF4]
:Validate changes;
if ($question("Changed by another User?")) then ($guard_left("[not changed]"))
  ' [NF4, POST1, BR-PRODUCT-OWNER-BACKLOG]
  :Save changes;
  ' [POST2]
  :Record update in
  item activity history;
else ($guard_right("[changed by another", "User — EX-01]"))
  |SYS|
  ' [EX-01, GUIDE-7.3]
  :Reject item update;
endif
|SYS|
stop
@enduml
