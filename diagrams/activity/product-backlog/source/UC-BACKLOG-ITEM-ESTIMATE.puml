@startuml UC-BACKLOG-ITEM-ESTIMATE
' UC-18 - Estimate Backlog Item | semantic key: UC-BACKLOG-ITEM-ESTIMATE
' Source: data/use_cases/product-backlog/UC-BACKLOG-ITEM-ESTIMATE.yml
' Business Rules: BR-DEVELOPER-ESTIMATION, BR-BACKLOG-ITEM-READY, BR-PROJECT-ARCHIVED-READ-ONLY
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' Final nodes: F1 = estimate left unset and item marked as requiring further refinement (AF-01); F2
' = shared final after the agreed estimate is recorded (postconditions met) or the estimate is
' rejected (EX-01). A single final was tried: drawing the rest of the flow inside the [sufficient]
' branch drops the guard text below 6 pt at A4, so AF-01 keeps its own final.
' NF3 (the Product Owner clarifies "when requested") is drawn as a decision in the Product Owner
' lane.
!include ../../_shared/activity-style.puml

|DEV| $lane_title("Developer")
|SYS| $lane_title("System")
|PRO| $lane_title("Product Owner")

|DEV|
start
' [NF1]
:Select refined
Product Backlog Item;
|SYS|
' [NF2]
:Display item details
and current estimate;
|PRO|
if ($question_x("Clarification requested?")) then ($guard_left("[requested]"))
  ' [NF3]
  :Clarify expected outcome;
else ($guard_right("[not", "requested]"))
endif
|DEV|
if ($question_x("Sufficiently refined?")) then ($guard_left("[sufficient]"))
  ' [NF4, BR-DEVELOPER-ESTIMATION]
  :Provide agreed estimate;
else ($guard_right("[not refined", "— AF-01]"))
  |SYS|
  ' [AF-01.1]
  :Leave estimate unset;
  ' [AF-01.2, BR-BACKLOG-ITEM-READY]
  :Mark item as requiring
  further refinement;
  stop
endif
|SYS|
' [NF5]
:Validate estimate;
if ($question("Item still estimable?")) then ($guard_left("[estimable]"))
  ' [NF5, POST1]
  :Record estimate;
  ' [POST2]
  :Record estimate change
  in item activity history;
else ($guard_right("[removed or in", "completed Sprint — EX-01]"))
  |SYS|
  ' [EX-01, GUIDE-7.3]
  :Reject estimate;
endif
|SYS|
stop
@enduml
