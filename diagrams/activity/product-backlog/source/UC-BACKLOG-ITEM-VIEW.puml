@startuml UC-BACKLOG-ITEM-VIEW
' UC-15.1 - View Product Backlog Item | semantic key: UC-BACKLOG-ITEM-VIEW
' Source: data/use_cases/product-backlog/UC-BACKLOG-ITEM-VIEW.yml
' Business Rules: BR-PROJECT-MEMBER-ACCESS
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' Final nodes: F1 = item details displayed without modification (postcondition met); F2 = selected
' item no longer available, nothing displayed (EX-01; the UC describes no response).
!include ../../_shared/activity-style.puml

|USR| $lane_title("User")
|SYS| $lane_title("System")

|USR|
start
' [NF1]
:Select Product Backlog Item;
|SYS|
' [NF2]
:Retrieve current
item information;
if ($question("Item still available?")) then ($guard_left("[available]"))
  ' [NF3, POST1]
  :Display item details and
  related Sprint information;
  stop
else ($guard_right("[no longer", "available — EX-01]"))
  |SYS|
  stop
endif
@enduml
