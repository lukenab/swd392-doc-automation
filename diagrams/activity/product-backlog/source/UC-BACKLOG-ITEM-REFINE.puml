@startuml UC-BACKLOG-ITEM-REFINE
' UC-17 - Refine Backlog Item | semantic key: UC-BACKLOG-ITEM-REFINE
' Source: data/use_cases/product-backlog/UC-BACKLOG-ITEM-REFINE.yml
' Business Rules: BR-PRODUCT-OWNER-BACKLOG, BR-BACKLOG-ITEM-READY, BR-PROJECT-ARCHIVED-READ-ONLY
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' EX-01: the System rejects only the decomposition; refinement then continues with NF5-NF6
' without splitting the item (YAML), so the EX-01 path merges back before NF5.
!include ../../_shared/activity-style.puml

|PRO| $lane_title("Product Owner")
|SYS| $lane_title("System")
|DEV| $lane_title("Developer")

|PRO|
start
' [NF1]
:Select item that
requires refinement;
|SYS|
' [NF2]
:Display current item
details and estimate;
|PRO|
' [NF3]
:Clarify expected outcome
and acceptance criteria;
|DEV|
' [NF4]
:Add implementation clarification
and propose decomposition if needed;
if ($question("Too large for one Sprint?")) then ($guard_left("[fits one Sprint]"))
else ($guard_right("[too large", "— AF-01]"))
  |SYS|
  if ($question_x("Item in active Sprint?")) then ($guard_left("[not in Sprint]"))
    |PRO|
    ' [AF-01.1, BR-PRODUCT-OWNER-BACKLOG]
    :Define smaller independent
    items with Developer;
    |SYS|
    ' [AF-01.2]
    :Preserve traceability
    to original item;
  else ($guard_right("[in active Sprint", "— EX-01]"))
    |SYS|
    ' [EX-01, GUIDE-7.3]
    :Reject item decomposition;
  endif
endif
|PRO|
' [NF5]
:Confirm refined scope
and description;
|SYS|
' [NF6, POST1, POST2]
:Save refined item and
record participants;
stop
@enduml
