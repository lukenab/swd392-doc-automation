@startuml UC-BACKLOG-ORDER
' UC-16 - Order Product Backlog | semantic key: UC-BACKLOG-ORDER
' Source: data/use_cases/product-backlog/UC-BACKLOG-ORDER.yml
' Business Rules: BR-PRODUCT-OWNER-BACKLOG, BR-PROJECT-ARCHIVED-READ-ONLY
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' One Activity Final shared by all paths (team decision 2026-10-05; UML allows one or several). It
' is reached after the new order is saved and displayed (postcondition met) or after EX-01 (new
' order not saved, previous order kept; the UC describes no response, so no action is drawn).
!include ../../_shared/activity-style.puml

|PRO| $lane_title("Product Owner")
|SYS| $lane_title("System")

|PRO|
start
' [NF1]
:Open ordered Product Backlog;
|SYS|
' [NF2]
:Display available items
in current order;
|PRO|
' [NF3]
:Change relative order
of one or more items;
|SYS|
' [NF4]
:Validate new order;
while ($question_x("Order changed concurrently?")) is ($guard_left("[changed — AF-01]"))
  ' [AF-01.1]
  :Refresh current Product Backlog order;
  |PRO|
  ' [AF-01.2]
  :Reapply intended changes;
  |SYS|
endwhile ($guard("[not changed]"))
if ($question("Complete unique order?")) then ($guard_left("[complete]"))
  ' [NF4, POST1, BR-PRODUCT-OWNER-BACKLOG]
  :Save new order;
  ' [NF5, POST1]
  :Display updated
  Product Backlog;
else ($guard_right("[cannot be saved", "— EX-01]"))
endif
|SYS|
stop
@enduml
