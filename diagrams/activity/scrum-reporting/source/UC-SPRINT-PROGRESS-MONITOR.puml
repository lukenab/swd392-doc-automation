@startuml UC-SPRINT-PROGRESS-MONITOR
' UC-31 - Monitor Sprint Progress | semantic key: UC-SPRINT-PROGRESS-MONITOR
' Source: data/use_cases/scrum-reporting/UC-SPRINT-PROGRESS-MONITOR.yml
' Business Rules: BR-PROJECT-MEMBER-ACCESS, BR-PROGRESS-ACTIVE-SPRINT
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' One Activity Final shared by all paths (team decision 2026-10-06; UML allows one or several). It
' is reached after the Sprint indicators are displayed (NF4, also after AF-01; postconditions met)
' or after EX-01 (no active Sprint, no progress calculated, BR-PROGRESS-ACTIVE-SPRINT). The UC does
' not describe a response to EX-01, so no action is drawn (Needs clarification).
!include ../../_shared/activity-style.puml
|USR| $lane_title("User")
|SYS| $lane_title("System")

|USR|
start
' [NF1, BR-PROJECT-MEMBER-ACCESS]
:Open Sprint progress view;
|SYS|
if ($question_x("Active Sprint exists?")) then ($guard_left("[active Sprint]"))
  ' [NF2]
  :Aggregate work item status
  and estimates;
  ' [NF3]
  :Calculate completion, remaining work,
  overdue items and member workload;
  if ($question("All work items estimated?")) then ($guard_left("[all estimated]"))
  else ($guard_right("[estimates", "missing — AF-01]"))
    ' [AF-01.1]
    :Label estimate-based measures as incomplete;
  endif
  ' [NF4, AF-01.2, POST1]
  :Display Sprint indicators
  and charts;
else ($guard_right("[no active", "Sprint — EX-01]"))
endif
stop
@enduml
