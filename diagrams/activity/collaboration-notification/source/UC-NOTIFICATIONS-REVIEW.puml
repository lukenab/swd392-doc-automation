@startuml UC-NOTIFICATIONS-REVIEW
' UC-30 - Review Notifications | semantic key: UC-NOTIFICATIONS-REVIEW
' Source: data/use_cases/collaboration-notification/UC-NOTIFICATIONS-REVIEW.yml
' Business Rules: BR-NOTIFICATION-OWNER-ONLY, BR-PROJECT-MEMBER-ACCESS, BR-NOTIFICATION-EMAIL-PREFERENCE
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
' The User chooses to review one notification or to send another request (AF-01, AF-02);
' the System then distinguishes the received request.
' Final nodes: F1 = preference not saved, previous preference remains (EX-02). The UC describes no
' response to EX-02, so no action is drawn and the path ends at its own final (Needs clarification).
' F2 = shared final of all other paths: the completed paths (NF4, AF-01, AF-02 saved) and the
' unchanged paths (EX-01, EX-03) sit on nested branches, so separate finals would duplicate a final;
' the last action on each path states its outcome.
!include ../../_shared/activity-style.puml
|USR| $lane_title("User")
|SYS| $lane_title("System")

|USR|
start
' [NF1, BR-NOTIFICATION-OWNER-ONLY]
:Open notification
center;
|SYS|
' [NF2, BR-NOTIFICATION-OWNER-ONLY]
:Display notifications and email
preference, newest first;
|USR|
if ($question_x("Review a notification?")) then ($guard_left("[review]"))
  ' [NF3]
  :Select a
  notification;
  |SYS|
  if ($question_x("Item accessible?")) then ($guard_left("[accessible]"))
    ' [NF4, POST1, POST3]
    :Mark as read
    and display
    project context;
  else ($guard_right("[inaccessible", "— EX-01]"))
    ' [EX-01, BR-PROJECT-MEMBER-ACCESS, GUIDE-7.3]
    :Deny access
    to related
    item;
  endif
else ($guard_right("[other", "request]"))
  |SYS|
  if ($question_x("Requested action?")) then ($guard_left("[mark all — AF-01]"))
    ' [AF-01.1, POST1, POST3]
    :Mark all visible
    notifications
    as read;
  else ($guard_right("[change email", "delivery — AF-02]"))
    ' [AF-02.1, BR-NOTIFICATION-EMAIL-PREFERENCE]
    :Check verified
    email when
    enabling;
    if ($question("Change permitted?")) then ($guard_left("[disabling, or verified]"))
      ' [AF-02.2, POST2]
      :Save email
      delivery
      preference;
      if ($question("Preference saved?")) then ($guard_left("[saved]"))
      else ($guard_right("[not saved", "— EX-02]"))
        stop
      endif
    else ($guard_right("[enabling, not", "verified — EX-03]"))
      ' [EX-03, BR-NOTIFICATION-EMAIL-PREFERENCE]
      :Reject
      preference
      change;
    endif
  endif
endif
|USR|
stop
@enduml
