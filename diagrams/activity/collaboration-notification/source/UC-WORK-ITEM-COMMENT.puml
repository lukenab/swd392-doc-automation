@startuml UC-WORK-ITEM-COMMENT
' UC-28 - Comment on Work Item | semantic key: UC-WORK-ITEM-COMMENT
' Source: data/use_cases/collaboration-notification/UC-WORK-ITEM-COMMENT.yml
' Business Rules: BR-COMMENT-PROJECT-MEMBER, BR-ACTIVITY-IMMUTABLE, BR-NOTIFICATION-EMAIL-PREFERENCE, BR-NOTIFICATION-DELIVERY-INDEPENDENT
' Trace comments ' [ref] name the YAML element behind the next action.
' No title: the Word caption supplies it.
!include ../../_shared/activity-style.puml
|USR| $lane_title("User")
|SYS| $lane_title("System")
|EML| $lane_title("Email Service")

|USR|
start
' [NF1, BR-COMMENT-PROJECT-MEMBER]
:Open a work item and
enter a comment;
|SYS|
' [NF2, BR-COMMENT-PROJECT-MEMBER]
:Validate the comment and
referenced members;
while ($question("Comment has no content?")) is ($guard_left("[empty — AF-01]"))
  ' [AF-01.1]
  :Ask the actor to enter content;
  |USR|
  ' [NF1]
  :Enter the comment content;
  |SYS|
endwhile ($guard("[content present]"))
|USR|
' [NF3]
:Submit the comment;
|SYS|
if ($question_x("Work item still exists?")) then ($guard_left("[exists]"))
else ($guard_right("[removed", "— EX-01]"))
  ' [EX-01, GUIDE-7.3]
  :Reject the comment because the work item was removed;
  stop
endif
' [NF4, POST1, BR-ACTIVITY-IMMUTABLE]
:Save the comment and record
it in activity history;
' [NF5, POST2]
:Create in-app notifications
for relevant members;
if ($question("Eligible email deliveries?")) then ($guard_left("[eligible]"))
  ' [NF5, POST2, BR-NOTIFICATION-EMAIL-PREFERENCE]
  :Request email delivery;
  |EML|
  ' [NF6]
  :Return the email
  delivery result;
  |SYS|
  if ($question_x("Email delivered?")) then ($guard_left("[delivered]"))
  else ($guard_right("[not delivered", "— EX-02]"))
    ' [EX-02, BR-NOTIFICATION-DELIVERY-INDEPENDENT]
    :Record the failed delivery and keep the saved comment;
  endif
else ($guard_right("[none", "eligible]"))
endif
stop
@enduml
